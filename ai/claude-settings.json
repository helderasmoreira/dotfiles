{
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>"
  },
  "permissions": {
    "allow": [
      "Read(~/Work/Carwow/claude-docs/**)",
      "Read(~/.claude/**)",
      "Bash(gh pr view)",
      "Bash(gh pr view *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status)",
      "Bash(gh pr status *)",
      "Bash(bundle show *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(carwow run bundle exec rspec *)",
      "Bash(carwow run bundle exec rubocop *)",
      "WebFetch(domain:rubyllm.com)",
      "mcp__claude_ai_Slack__slack_search_public_and_private"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/algolia/**)",
      "Read(~/.fly/**)",
      "Read(~/.boto)",
      "Read(~/.netrc)",
      "Read(~/.kube/**)"
    ],
    "ask": [
      "Read(**/.env*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(bq:*)",
      "Bash(gcloud:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue comment:*)",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_schedule_message",
      "mcp__claude_ai_Slack__slack_create_canvas",
      "mcp__claude_ai_Slack__slack_update_canvas"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "deniedMcpServers": [
    {
      "serverName": "claude.ai incident.io"
    },
    {
      "serverName": "cmux-cua"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/Work/dotfiles/ai/claude-hooks/bash-guard.sh",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/Work/dotfiles/ai/claude-statusline.sh"
  },
  "enabledPlugins": {
    "core@carwow-factory": true,
    "sre@carwow-factory": true,
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "ruby-lsp@claude-plugins-official": true,
    "humanizer@humanizer": true
  },
  "extraKnownMarketplaces": {
    "carwow-factory": {
      "source": {
        "source": "git",
        "url": "git@github.com:carwow/factory.git"
      }
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    }
  },
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true,
  "theme": "dark"
}
